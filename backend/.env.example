# Server port
PORT=5080

# Max upload size in MB
MAX_FILE_SIZE_MB=500

# CORS: set to your Vercel frontend URL in production
# e.g. https://reelcut.vercel.app
# Use * to allow all origins (fine for local dev)
CORS_ORIGIN=*

# Optional: explicit ffmpeg/ffprobe paths (not needed inside Docker)
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
